@page "/Account/ForgotPasswordConfirmation"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ENVIRIO.Data

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment

<PageTitle>Check Your Email — ENVIRIO</PageTitle>

<div class="auth-card text-center">
    <div class="auth-icon-box-lg info">
        <i class="bi bi-mailbox2"></i>
    </div>

    <div class="auth-header">
        <h2 class="auth-title">Check Your Email</h2>
        <p class="auth-subtitle">We have sent password reset instructions if an account matches the provided address.</p>
    </div>

    @if (resetPasswordLink is not null)
    {
        <div class="auth-alert auth-alert-warning text-start mb-3">
            <i class="bi bi-tools"></i>
            <div>
                <strong>Developer Shortcut (Development Mode):</strong>
                <p class="mb-2 mt-1 small">Because email delivery may be offline in local dev, use the direct reset link below to test resetting your password:</p>
                <a href="@resetPasswordLink" class="auth-btn-primary py-2 text-center mt-2">
                    <i class="bi bi-key-fill"></i>
                    <span>Reset Password Now</span>
                </a>
            </div>
        </div>
    }

    <div class="auth-alert auth-alert-info text-start">
        <i class="bi bi-info-circle-fill"></i>
        <span>If you do not see the email in your inbox within a few minutes, please check your spam or junk folder.</span>
    </div>

    <div class="auth-card-footer">
        <div>
            <a href="Account/Login" class="auth-link">
                <i class="bi bi-arrow-left"></i>
                <span>Return to Sign In</span>
            </a>
        </div>
    </div>
</div>

@code {
    private string? resetPasswordLink;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Environment.IsDevelopment() && !string.IsNullOrEmpty(Email))
        {
            var user = await UserManager.FindByEmailAsync(Email);
            if (user is not null)
            {
                var code = await UserManager.GeneratePasswordResetTokenAsync(user);
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
                resetPasswordLink = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                    new Dictionary<string, object?> { ["code"] = code, ["email"] = Email });
            }
        }
    }
}
