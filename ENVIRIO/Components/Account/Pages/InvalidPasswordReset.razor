@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid Reset Link — ENVIRIO</PageTitle>

<div class="auth-card text-center">
    <div class="auth-icon-box-lg danger">
        <i class="bi bi-link-45deg"></i>
    </div>

    <div class="auth-header">
        <h2 class="auth-title">Invalid Reset Link</h2>
        <p class="auth-subtitle">This password reset link is invalid, malformed, or has already expired.</p>
    </div>

    <div class="auth-alert auth-alert-danger text-start">
        <i class="bi bi-clock-history"></i>
        <span>Password reset tokens are single-use and expire after a limited period for security.</span>
    </div>

    <div class="auth-card-footer">
        <div>
            <a href="Account/ForgotPassword" class="auth-btn-primary mb-2">
                <i class="bi bi-arrow-repeat"></i>
                <span>Request New Reset Link</span>
            </a>
        </div>
        <div>
            <a href="Account/Login" class="auth-link small text-muted">Back to Sign In</a>
        </div>
    </div>
</div>
