@page "/Account/ResetPasswordConfirmation"
<PageTitle>Password Updated — ENVIRIO</PageTitle>

<div class="auth-card text-center">
    <div class="auth-icon-box-lg success">
        <i class="bi bi-shield-check"></i>
    </div>

    <div class="auth-header">
        <h2 class="auth-title">Password Reset Complete</h2>
        <p class="auth-subtitle">Your password has been securely updated. You can now sign in with your new credentials.</p>
    </div>

    <div class="auth-card-footer">
        <div>
            <a href="Account/Login" class="auth-btn-primary">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Sign In Now</span>
            </a>
        </div>
    </div>
</div>
